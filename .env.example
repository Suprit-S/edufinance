# Copy to .env and change the secrets before deploying.
# docker compose reads .env automatically. Never commit the real .env.

POSTGRES_DB=edufinance
POSTGRES_USER=edufinance
POSTGRES_PASSWORD=change-me-strong-password

# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Load the demo user "Ananya Rao" on start-up (idempotent)
SEED_DEMO=true

# Port on the host machine
APP_PORT=8080
